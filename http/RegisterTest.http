@url = localhost:7070/api

### Ugyldig email, 400
POST http://{{url}}/auth/register
Content-Type: application/json

{ "username": "test", "email": "abc", "password": "x" }


### Gyldig email, 201
POST http://{{url}}/auth/register
Content-Type: application/json

{ "username": "lucas", "email": "lucas@test5.dk", "password": "test1234" }

### Test af sammen email, fejl 409
POST http://{{url}}/auth/register
Content-Type: application/json

{ "username": "lucas2", "email": "lucas@test5.dk", "password": "test1234" }

### Test af login

### Test af login, 200
POST http://{{url}}/auth/login
Content-Type: application/json

{"email": "lucas@test5.dk", "password": "test1234" }


### Test af login ved forkert kode, 401
POST http://{{url}}/auth/login
Content-Type: application/json

{ "email": "lucas@test5.dk", "password": "forkert" }

### Test af login ved forkert email, 401
POST http://{{url}}/auth/login
Content-Type: application/json

{ "email": "lucas@forkert.dk", "password": "test1234" }


### Gyldig email til test af mismatch, 201
POST http://{{url}}/auth/register
Content-Type: application/json

{ "username": "lucas", "email": "lucas@test6.dk", "password": "test" }

### Test af login ved brug af mismatch, 401
POST http://{{url}}/auth/login
Content-Type: application/json

{ "email": "lucas@test5.dk", "password": "test" }


> {% client.global.set("token", response.body.token); %}